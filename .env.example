# ReviewLens Environment Configuration
# Copy this file to .env and fill in your actual values

# Application Environment
APP_ENV=dev

# LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp
LLM_RPM_LIMIT=10
LLM_TIMEOUT_S=45

# Database Configuration
DUCKDB_PATH=data/warehouse/reviewlens.duckdb
DATA_META_PATH=data/processed/meta.json

# Vector Database Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=reviews

# Search Configuration
RETRIEVAL_MODE=hybrid_rrf
RETRIEVAL_TOP_K=8
RETRIEVAL_PREFETCH_K=30
FASTEMBED_CACHE_PATH=.fastembed_cache

# SQL Configuration
SQL_MAX_ROWS=500
SQL_TIMEOUT_S=15
SQL_MAX_ATTEMPTS=3

# Agent Configuration
AGENT_MAX_LLM_CALLS=8
AGENT_TIMEOUT_S=60

# API Configuration
INGEST_API_KEY=your_secret_ingest_key_here
RATE_LIMIT_PER_MIN=10

# Cloud Configuration (for production deployment)
# QDRANT_URL=https://your-cluster.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_cloud_api_key